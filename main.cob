IDENTIFICATION DIVISION.
PROGRAM-ID. COBOLFETCH.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CPUFILE
        ASSIGN TO "/proc/cpuinfo"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.

FILE SECTION.

FD CPUFILE.
01 CPU-LINE PIC X(256).

WORKING-STORAGE SECTION.

*> coloring
01 CYAN  PIC X(5) VALUE X"1B5B33366D".
01 RESETCOLOR PIC X(4) VALUE X"1B5B306D".


*> uname
01 UTSNAME.
    05 OS-NAME      PIC X(65).
    05 NODE-NAME    PIC X(65).
    05 OS-RELEASE   PIC X(65).
    05 OS-VERSION   PIC X(65).
    05 MACHINE      PIC X(65).
    05 DOMAIN-NAME  PIC X(65).

01 OSRESULT PIC S9(9) COMP-5.

*> cpu parse 
01 CPU-MODEL PIC X(256).
01 CPU-KEY   PIC X(32).
01 EOF-FLAG  PIC X VALUE "N".
01 CPU-FOUND PIC X VALUE "N".

PROCEDURE DIVISION.

    *> cpu from cpuinfo
    OPEN INPUT CPUFILE.

    PERFORM UNTIL EOF-FLAG = "Y" OR CPU-FOUND = "Y"

        READ CPUFILE
            AT END
                MOVE "Y" TO EOF-FLAG

            NOT AT END
                IF CPU-LINE(1:10) = "model name"
                    UNSTRING CPU-LINE
                        DELIMITED BY ":"
                        INTO CPU-KEY CPU-MODEL
                    END-UNSTRING

                    MOVE "Y" TO CPU-FOUND
                END-IF
        END-READ

    END-PERFORM.

    CLOSE CPUFILE.

    *> calling system stuffs from uname
    CALL "uname"
        USING BY REFERENCE UTSNAME
        RETURNING OSRESULT.

    *> print
    DISPLAY CYAN "Hostname: " RESETCOLOR NODE-NAME.
    DISPLAY CYAN "OS: " RESETCOLOR OS-NAME.
    DISPLAY CYAN "Kernel: " RESETCOLOR OS-RELEASE.
    DISPLAY CYAN "CPU: " RESETCOLOR FUNCTION TRIM(CPU-MODEL).
    DISPLAY CYAN "Arch: " RESETCOLOR MACHINE.

    STOP RUN.